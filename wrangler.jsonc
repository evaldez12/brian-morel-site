{
  // Cloudflare Workers config. The name must match the Worker name in the dashboard.
  "name": "brian-morel-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
